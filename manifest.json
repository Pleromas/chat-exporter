{
  "manifest_version": 3,
  "name": "Chat Exporter (local)",
  "version": "1.1.3",
  "description": "Export ChatGPT conversations to Markdown, JSON, HTML or PDF. Nothing is uploaded anywhere.",

  "browser_specific_settings": {
    "gecko": {
      "id": "{4ef41f2c-61ba-48d0-b6d0-a866f7807147}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "permissions": ["downloads", "storage"],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Export this chat",
    "default_icon": {
      "48": "icon.svg",
      "96": "icon.svg"
    }
  },

  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["markdown.js", "doc.js", "extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
